meta {
  name: Google Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/google
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "credential": "{{googleCredential}}"
  }
}

script:post-response {
  const data = res.getBody();
  if (data.token) bru.setEnvVar("token", data.token);
  if (data.user?.id) bru.setEnvVar("userId", data.user.id);
}
